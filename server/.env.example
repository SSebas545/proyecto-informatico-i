# Copiar a `.env` en esta carpeta y completar con los datos reales.
# Este archivo NO lleva valores verdaderos: es la plantilla del repositorio.

# Conexión a MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_de_la_base
DB_PASSWORD=cambiar_esta_clave
DB_NAME=libreria_db

# Secreto para firmar los JWT. Tiene que ser largo y distinto en cada entorno.
# Sin esta variable el servidor no arranca (a propósito).
JWT_SECRET=cambiar_por_una_cadena_larga_y_aleatoria

# Puerto del servidor (API + frontend estático)
PORT=3000

# development | production
NODE_ENV=development

# Opcional: orígenes permitidos para CORS, separados por coma.
# Si se deja vacío, se permite cualquier origen (solo razonable en desarrollo).
# CORS_ORIGIN=http://localhost:3000
