        <!-- ================= NOTAS ================= -->

        <mxCell id="nota_pendientes" value="&lt;b&gt;PENDIENTE — revisar contra los 17 CU&lt;/b&gt;&lt;br&gt;&lt;br&gt;• CU-07 (Recomendaciones): no hay tabla; se deriva de historial de pedidos.&lt;br&gt;• CU-17 (Alertas stock bajo): se deriva de libros.stock (&amp;lt; 5).&lt;br&gt;• Préstamos: la ficha del cliente menciona venta y préstamo, pero los 17 CU solo cubren venta.&lt;br&gt;&lt;br&gt;&lt;i&gt;Base: esquema real de server/database.js.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=#e53e3e;fillColor=#fff5f5;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#2d3748;rounded=1;" vertex="1" parent="1">
